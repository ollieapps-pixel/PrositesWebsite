---
import type { DemoSite } from '../../data/demos/types';
interface Props { site: DemoSite; light?: boolean }
const { site, light = false } = Astro.props;
---
<a href={`/demo/${site.slug}/`} class:list={['logo', { 'logo--light': light }]} aria-label={`${site.name} home`}>
  <svg width="34" height="34" viewBox="0 0 34 34" aria-hidden="true">
    <rect width="34" height="34" rx={site.theme.radius.logo} style={`fill: ${light ? 'var(--d-accent)' : 'var(--d-navy)'}`} />
    <text x="17" y="24" text-anchor="middle" font-size="19" font-weight="800"
          style={`font-family: var(--d-font), sans-serif; fill: ${light ? 'var(--d-navy-deep)' : '#ffffff'}`}>{site.monogram}</text>
  </svg>
  <span class="logo__t"><strong>{site.short}</strong><span>{site.tagline}</span></span>
</a>
<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; color: var(--d-ink); min-height: 44px; }
  .logo__t { display: flex; flex-direction: column; line-height: 1.1; }
  .logo__t strong { font-size: 1.125rem; font-weight: 800; letter-spacing: -0.01em; }
  .logo__t span { font-size: 0.78rem; font-weight: 600; color: var(--d-muted); }
  .logo--light { color: #fff; }
  .logo--light .logo__t span { color: var(--d-on-navy); }
</style>
