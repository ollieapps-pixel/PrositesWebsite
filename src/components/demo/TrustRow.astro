---
import Stars from './Stars.astro';
import type { DemoSite } from '../../data/demos/types';
interface Props { site: DemoSite; dark?: boolean }
const { site, dark = false } = Astro.props;
---
<ul class:list={['trust', { 'trust--dark': dark }]}>
  <li><Stars size={16} label={`Rated ${site.rating} out of 5`} /><strong>{site.rating} on Google</strong><span>{site.reviewCount} reviews</span></li>
  {site.trust.map((t) => <li><strong>{t.strong}</strong><span>{t.span}</span></li>)}
</ul>
<style>
  .trust { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
  .trust li { display: flex; flex-direction: column; gap: 2px; padding-left: 14px; border-left: 3px solid var(--d-accent); }
  .trust strong { font-size: 1rem; font-weight: 800; color: var(--d-ink); line-height: 1.3; }
  .trust span { font-size: 0.875rem; color: var(--d-muted); line-height: 1.35; }
  .trust--dark strong { color: #fff; }
  .trust--dark span { color: var(--d-on-navy); }
  @media (max-width: 900px) { .trust { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 14px; } }
</style>
