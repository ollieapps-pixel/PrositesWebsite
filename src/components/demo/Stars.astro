---
interface Props { size?: number; label?: string }
const { size = 18, label = 'Rated 5 out of 5' } = Astro.props;
---
<span class="stars" role="img" aria-label={label}>
  {[0, 1, 2, 3, 4].map(() => (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="var(--d-accent)" aria-hidden="true"><path d="M12 2.4l2.9 6.1 6.6.9-4.8 4.7 1.2 6.6L12 17.6l-5.9 3.1 1.2-6.6-4.8-4.7 6.6-.9z" /></svg>
  ))}
</span>
<style>.stars { display: inline-flex; gap: 2px; }</style>
