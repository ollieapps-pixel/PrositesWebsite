---
import Icon from '../Icon.astro';
import type { DemoSite } from '../../data/demos/types';
interface Props { site: DemoSite; quoteHref: string }
const { site, quoteHref } = Astro.props;
---
<section class="cta">
  <div class="d-wrap cta__in">
    <div class="cta__copy">
      <h2>{site.cta.heading}</h2>
      <p>{site.cta.body}</p>
    </div>
    <div class="cta__btns">
      <a class="d-btn d-btn--call" href={site.phoneHref}><Icon name="phone" size={20} stroke="currentColor" />Call {site.phone}</a>
      <a class="d-btn d-btn--line" href={quoteHref}>Get a quote</a>
    </div>
  </div>
</section>
<style>
  .cta { background: var(--d-navy); color: #fff; }
  .cta__in { display: flex; align-items: center; justify-content: space-between; gap: 24px 48px; flex-wrap: wrap; padding-block: 48px; }
  .cta__copy { display: flex; flex-direction: column; gap: 8px; max-width: 640px; }
  .cta h2 { color: #fff; font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2rem); }
  .cta p { color: var(--d-on-navy); }
  .cta__btns { display: flex; gap: 12px; flex-wrap: wrap; }
</style>
