---
import type { DemoSite } from '../../data/demos/types';
interface Props { site: DemoSite }
const { site } = Astro.props;
---
<ol class="st">
  {site.steps.map((s, i) => (
    <li class="st__i">
      <span class="st__n" aria-hidden="true">{i + 1}</span>
      <h3>{s.title}</h3>
      <p>{s.body}</p>
    </li>
  ))}
</ol>
<style>
  .st { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .st__i { display: flex; flex-direction: column; gap: 10px; padding-top: 20px; border-top: 3px solid var(--d-navy); }
  .st__n { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 0; background: var(--d-accent); color: var(--d-ink); font-weight: 800; }
  .st__i p { color: var(--d-muted); }
  @media (max-width: 760px) { .st { grid-template-columns: minmax(0, 1fr); } }
</style>
