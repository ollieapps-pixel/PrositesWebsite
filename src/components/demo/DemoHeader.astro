---
import Logo from './Logo.astro';
import Icon from '../Icon.astro';
import type { DemoSite } from '../../data/demos/types';
interface Props { site: DemoSite; current?: string }
const { site, current } = Astro.props;
const base = `/demo/${site.slug}`;
const links = [
  { key: 'services', label: 'Services', href: `${base}/services/` },
  { key: 'areas', label: 'Areas', href: `${base}/areas/` },
  { key: 'about', label: 'About', href: `${base}/about/` },
  { key: 'contact', label: 'Contact', href: `${base}/contact/` },
];
const quoteHref = current === 'contact' ? '#quote' : `${base}/contact/`;
---
<header class="hdr">
  <div class="d-wrap hdr__in">
    <Logo site={site} />
    <nav aria-label="Main" class="hdr__nav">
      <ul>
        {links.map((l) => (
          <li><a href={l.href} class:list={{ 'is-current': current === l.key }} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="hdr__cta">
      <a class="hdr__tel" href={site.phoneHref}>
        <Icon name="phone" size={20} stroke="var(--d-icon, var(--d-navy))" />
        <span>{site.phone}</span>
      </a>
      <a class="d-btn d-btn--call hdr__quote" href={quoteHref}>Get a quote</a>
    </div>
  </div>
  <nav aria-label="Pages" class="hdr__mnav">
    <ul class="d-wrap">
      {links.map((l) => (
        <li><a href={l.href} class:list={{ 'is-current': current === l.key }} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a></li>
      ))}
    </ul>
  </nav>
</header>
<style>
  .hdr { position: sticky; top: 0; z-index: 20; background: var(--d-surface); border-bottom: 1px solid var(--d-line); }
  .hdr__in { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding-block: 10px; }
  .hdr__nav ul { display: flex; gap: 26px; list-style: none; margin: 0; padding: 0; }
  .hdr__nav a, .hdr__mnav a { color: var(--d-ink-2); font-weight: 600; text-decoration: none; }
  .hdr__nav a:hover, .hdr__mnav a:hover, .hdr a.is-current { color: var(--d-navy); }
  .hdr a.is-current { box-shadow: inset 0 -3px 0 var(--d-accent); }
  .hdr__nav a { display: inline-flex; align-items: center; min-height: 44px; }
  .hdr__cta { display: flex; align-items: center; gap: 14px; }
  .hdr__tel { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 4px; font-weight: 800; color: var(--d-ink); text-decoration: none; white-space: nowrap; }
  .hdr__quote { min-height: 44px; padding: 10px 18px; font-size: 0.97rem; }
  .hdr__mnav { display: none; border-top: 1px solid var(--d-line); }
  .hdr__mnav ul { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); list-style: none; margin: 0 auto; padding: 0; }
  .hdr__mnav a { display: flex; align-items: center; justify-content: center; min-height: 44px; font-size: 0.95rem; }
  @media (max-width: 960px) { .hdr__nav { display: none; } .hdr__mnav { display: block; } }
  @media (max-width: 560px) {
    .hdr__in { padding-block: 6px; }
    .hdr__quote { display: none; }
    .hdr__tel span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .hdr__tel { width: 44px; justify-content: center; border: 1px solid var(--d-line); border-radius: var(--d-r-btn); }
  }
</style>
