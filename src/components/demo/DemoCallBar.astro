---
import Icon from '../Icon.astro';
import type { DemoSite } from '../../data/demos/types';
interface Props { site: DemoSite }
const { site } = Astro.props;
---
<div class="cb" role="region" aria-label={`Contact ${site.short}`}>
  <a class="d-btn d-btn--call cb__b" href={site.phoneHref}><Icon name="phone" size={20} stroke="currentColor" /><span>Call now</span></a>
  <a class="d-btn d-btn--wa cb__b" href={site.whatsappHref}>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.2a9.8 9.8 0 0 0-8.4 14.8L2.2 21.8l4.9-1.3A9.8 9.8 0 1 0 12 2.2zm0 2a7.8 7.8 0 1 1-4 14.5l-.4-.2-2.5.6.7-2.4-.3-.4A7.8 7.8 0 0 1 12 4.2z"/><path d="M9.3 7.7c-.2-.5-.4-.5-.6-.5h-.5c-.2 0-.5.1-.7.4-.3.3-.9.9-.9 2s.9 2.3 1 2.5c.1.2 1.7 2.7 4.2 3.7 2 .8 2.5.7 2.9.6.5 0 1.4-.6 1.6-1.2.2-.6.2-1 .1-1.1l-.5-.3-1.6-.8c-.2-.1-.4-.1-.5.1l-.8 1c-.1.2-.3.2-.5.1-.2-.1-1.1-.4-2-1.2-.7-.6-1.2-1.4-1.3-1.6-.1-.2 0-.3.1-.4l.4-.5c.1-.2.1-.3.2-.5v-.4l-.6-1.4z"/></svg>
    <span>WhatsApp</span>
  </a>
</div>
<style>
  .cb { display: none; position: fixed; inset: auto 0 0 0; z-index: 30; gap: 10px;
    padding: 10px 12px calc(10px + env(safe-area-inset-bottom));
    background: var(--d-surface); border-top: 1px solid var(--d-line); box-shadow: 0 -6px 20px rgba(14,27,44,0.1); }
  .cb__b { flex: 1 1 0; width: auto; }
  @media (max-width: 768px) { .cb { display: flex; } }
</style>
