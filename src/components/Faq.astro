---
interface Props { items: readonly { q: string; a: string }[]; openFirst?: boolean; }
const { items, openFirst = true } = Astro.props;
---
<div class="faq">
  {items.map((it, i) => (
    <details class="faq__i card" open={openFirst && i === 0}>
      <summary class="faq__q">
        <span>{it.q}</span>
        <svg class="faq__ico" width="20" height="20" viewBox="0 0 24 24" stroke="currentColor"
             stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
          <path d="M5 12h14" /><path class="faq__v" d="M12 5v14" />
        </svg>
      </summary>
      <p class="faq__a" set:html={it.a} />
    </details>
  ))}
</div>

<style>
  .faq { display: flex; flex-direction: column; gap: 12px; }
  .faq__i { padding: 0; }
  .faq__q {
    display: flex; gap: 20px; justify-content: space-between; align-items: flex-start;
    padding: 22px 24px; cursor: pointer; list-style: none;
    font-size: 1.125rem; font-weight: 700; letter-spacing: -0.01em; color: var(--c-ink);
  }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__ico { flex-shrink: 0; margin-top: 3px; color: #8c9895; transition: color 0.15s ease; }
  .faq__i[open] .faq__ico { color: var(--c-orange); }
  .faq__i[open] .faq__v { display: none; }
  .faq__a {
    padding: 0 24px 22px; margin: 0; max-width: 66ch;
    font-size: 1rem; line-height: 1.6; color: var(--c-muted);
  }
  @media (max-width: 560px) { .faq__q { padding: 18px; font-size: 1.0625rem; } .faq__a { padding: 0 18px 18px; } }
</style>
