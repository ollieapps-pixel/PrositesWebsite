---
import { nav, contact } from '../data/site';
import Button from './Button.astro';
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="hdr">
  <div class="wrap hdr__in">
    <a href="/" class="logo" aria-label="ProSites home">
      <span class="logo__ph">LOGO</span>
    </a>

    <nav class="nav" aria-label="Main">
      <ul class="nav__list">
        {nav.map((i) => (
          <li>
            <a href={i.href} class:list={['nav__link', { 'is-current': isCurrent(i.href) }]}
               aria-current={isCurrent(i.href) ? 'page' : undefined}>{i.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="hdr__cta">
      <a class="hdr__tel" href={contact.phoneHref}>{contact.phone}</a>
      <Button href="/demo/" size="sm">See the Demo Site</Button>
    </div>

    <button class="burger" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="mnav" id="mobile-nav" hidden>
    <ul class="mnav__list">
      {nav.map((i) => (
        <li><a href={i.href} class:list={['mnav__link', { 'is-current': isCurrent(i.href) }]}>{i.label}</a></li>
      ))}
    </ul>
    <a class="mnav__tel" href={contact.phoneHref}>{contact.phone}</a>
  </div>
</header>

<style>
  .hdr { background: var(--c-surface); border-bottom: 1px solid var(--c-border); position: sticky; top: 0; z-index: 20; }
  .hdr__in { display: flex; align-items: center; justify-content: space-between; gap: 32px; padding-block: 16px; }

  .logo { display: flex; align-items: center; min-height: 44px; text-decoration: none; }
  .logo__ph {
    display: grid; place-items: center; width: 152px; height: 38px;
    background: #dde1dc; border: 1px solid #c6ccc5; border-radius: 6px;
    font-size: 12px; font-weight: 700; letter-spacing: 0.06em; color: #6c756b;
  }

  .nav__list { display: flex; align-items: center; gap: 26px; list-style: none; margin: 0; padding: 0; }
  .nav__link { font-size: 1rem; font-weight: 600; color: var(--c-ink-2); text-decoration: none; }
  .nav__link:hover, .nav__link.is-current { color: var(--c-orange); }

  .hdr__cta { display: flex; align-items: center; gap: 18px; }
  .hdr__tel { font-size: 1rem; font-weight: 700; color: var(--c-ink); text-decoration: none; white-space: nowrap; }

  .burger { display: none; width: 44px; height: 44px; background: none; border: 0; padding: 0; cursor: pointer; }
  .burger span { display: block; width: 22px; height: 2.5px; background: var(--c-ink); border-radius: 2px; margin: 5px auto; transition: transform 0.2s ease, opacity 0.2s ease; }
  .burger[aria-expanded='true'] span:nth-child(1) { transform: translateY(7.5px) rotate(45deg); }
  .burger[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .burger[aria-expanded='true'] span:nth-child(3) { transform: translateY(-7.5px) rotate(-45deg); }

  .mnav { border-top: 1px solid var(--c-border); padding: 8px var(--gut) 20px; }
  .mnav__list { list-style: none; margin: 0; padding: 0; }
  .mnav__link {
    display: block; padding: 14px 4px; font-size: 1.0625rem; font-weight: 600;
    color: var(--c-ink); text-decoration: none; border-bottom: 1px solid var(--c-hairline);
  }
  .mnav__link.is-current { color: var(--c-orange); }
  .mnav__tel { display: inline-block; margin-top: 16px; font-weight: 700; color: var(--c-ink); text-decoration: none; }

  @media (max-width: 1080px) {
    .nav, .hdr__cta { display: none; }
    .burger { display: block; }
  }
  @media (min-width: 1081px) { .mnav { display: none !important; } }
</style>

<script>
  const burger = document.querySelector<HTMLButtonElement>('.burger');
  const panel = document.getElementById('mobile-nav');
  burger?.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!open));
    burger.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
    if (panel) panel.hidden = open;
  });
</script>
