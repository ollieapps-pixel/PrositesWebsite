---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import CheckList from '../components/CheckList.astro';
import Faq from '../components/Faq.astro';
import CallBar from '../components/CallBar.astro';
import Ph from '../components/Ph.astro';
import Plan from '../components/Plan.astro';
import AddOns from '../components/AddOns.astro';
import { meta, trustBar, problem, solution, includedWebsite, includedApp, steps,
         monthlyApp, monthlyHosting, work, faqs } from '../data/content';
import { pricing, trades, testimonials } from '../data/site';

import hero from '../assets/placeholder/hero.jpg';
import searching from '../assets/placeholder/customer-searching.jpg';
import build from '../assets/placeholder/web-build.jpg';
import noMeetings from '../assets/placeholder/no-meetings.jpg';
import jobApp from '../assets/placeholder/job-app.jpg';
import avatar from '../assets/placeholder/testimonial.jpg';
---

<Base title={meta.home.title} description={meta.home.description} localBusiness>

  <section class="hero">
    <div class="hero__copy">
      <div class="hero__inner stack" style="gap:22px">
        <span class="eyebrow">For plumbers, electricians, appliance repair &amp; trades</span>
        <h1>Websites and Job Management for Home Service Businesses in Cape Town</h1>
        <p>Get a website that turns Google searches into booked jobs — and a simple app to run the jobs once they&rsquo;re booked. One fixed price, one system. Live in 14 days, {pricing.once} plus {pricing.monthly} a month.</p>
        <div class="hero__btns">
          <Button href="/demo/">See the Demo Site</Button>
          <Button href="/pricing/" variant="onDark">View Pricing</Button>
        </div>
        <p class="hero__note">No meetings required. Everything handled by WhatsApp and email.</p>
      </div>
    </div>
    <Image src={hero} alt="Plumber taking a call in a customer's kitchen" widths={[640, 900, 1200]}
           sizes="(max-width: 900px) 100vw, 50vw" loading="eager" fetchpriority="high" class="hero__img" />
  </section>

  <section class="trust">
    <div class="wrap grid g-4">
      {trustBar.map((i) => (
        <div class="card trust__c">
          <Icon name={i.icon} />
          <h2 class="trust__t">{i.label}</h2>
        </div>
      ))}
    </div>
  </section>

  <section class="sec wrap split">
    <Image src={searching} alt="Woman searching for a local trade on her phone at home"
           widths={[480, 720]} sizes="(max-width: 900px) 100vw, 45vw" class="split__img" />
    <div class="stack" style="gap:20px">
      <h2>{problem.h2}</h2>
      <p class="lede">{problem.lede}</p>
      <CheckList items={problem.bullets} />
    </div>
  </section>

  <section class="band">
    <div class="sec wrap split">
      <div class="stack" style="gap:20px">
        <h2>{solution.h2}</h2>
        <p class="lede">{solution.lede}</p>
        <CheckList items={solution.bullets} />
        <Button href="/demo/" class="self-start">See the Demo Site</Button>
      </div>
      <Image src={build} alt="Designer laying out a website on a laptop"
             widths={[480, 720]} sizes="(max-width: 900px) 100vw, 45vw" class="split__img" />
    </div>
  </section>

  <section class="sec wrap stack" style="gap:40px">
    <div class="stack center" style="gap:12px">
      <h2>Everything a service business actually needs</h2>
      <p class="lede">No bloat. No features you&rsquo;ll never use.</p>
    </div>

    <div class="rule"><span class="kicker">On your website</span><i></i></div>
    <div class="grid g-3">
      {includedWebsite.map((f) => (
        <div class="card feat">
          <Icon name={f.icon} size={30} />
          <h3 set:html={f.t} />
          <p class="feat__d" set:html={f.d} />
        </div>
      ))}
    </div>

    <div class="rule"><span class="kicker">In the job app</span><i></i></div>
    <div class="grid g-3">
      {includedApp.map((f) => (
        <div class="card feat">
          <Icon name={f.icon} size={30} />
          <h3 set:html={f.t} />
          <p class="feat__d" set:html={f.d} />
        </div>
      ))}
    </div>
  </section>

  <section class="band">
    <div class="sec wrap split">
      <Image src={noMeetings} alt="Working at a desk, no meeting required"
             widths={[480, 720]} sizes="(max-width: 900px) 100vw, 45vw" class="split__img" />
      <div class="stack" style="gap:28px">
        <h2>Three steps. No meetings.</h2>
        {steps.map((s) => (
          <div class="stack" style="gap:8px">
            <h3 class="kicker">Step {s.n} — {s.t}</h3>
            <p class="lede" set:html={s.d} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec on-petrol">
    <div class="wrap stack center" style="gap:24px">
      <div class="stack center" style="gap:6px">
        <h2>See exactly what you&rsquo;re getting</h2>
        <svg width="230" height="14" viewBox="0 0 230 14" fill="none" aria-hidden="true" class="squiggle">
          <path d="M4 9.5C46 4.2 150 2.6 226 6.4" stroke="var(--c-amber)" stroke-width="4" stroke-linecap="round" />
        </svg>
      </div>
      <p class="measure">Most web designers ask you to imagine what your site will look like. We&rsquo;ll just show you. Below is a live, working demo of the home service website — the same structure your site will be built on — and the job app you would use to run the work it brings in.</p>
      <div class="hero__btns center-btns">
        <Button href="/demo/">View the Website Demo</Button>
        <Button href="/demo/#app" variant="onDark">Preview the Job App</Button>
      </div>
      <Ph label="DEMO SCREENSHOT — DESKTOP + MOBILE" ratio="900 / 380" dark class="demo-shot" />
    </div>
  </section>

  <section class="sec wrap stack center" style="gap:26px">
    <h2>Built for the trades</h2>
    <p class="lede">If your customers find you when something breaks, this is built for you.</p>
    <ul class="chips">{trades.map((t) => <li class="chip">{t}</li>)}</ul>
    <p class="measure"><strong>Don&rsquo;t see your trade? If you go to customers&rsquo; homes to fix, install or maintain something, it&rsquo;ll work.</strong></p>
  </section>

  <section class="band" id="pricing">
    <div class="sec wrap stack" style="gap:36px">
      <div class="stack center" style="gap:12px">
        <h2>One price. Everything included.</h2>
        <p class="lede measure">No hourly rates. No quotes that take a week. No packages to compare — the website and the job app are one product.</p>
      </div>

      <Plan />
      <AddOns />
    </div>
  </section>

  <section class="sec on-petrol">
    <div class="wrap split">
      <div class="stack" style="gap:20px">
        <h2>What the {pricing.monthly} a month actually buys</h2>
        <p>Most web designers charge you a monthly fee to keep a server running. Yours runs the business. The app is the reason for the monthly — the hosting comes with it.</p>
        <div class="stack" style="gap:16px">
          <div class="stack" style="gap:10px">
            <h3 class="eyebrow">The job app</h3>
            <CheckList items={monthlyApp} tone="amber" />
          </div>
          <div class="stack" style="gap:10px">
            <h3 class="eyebrow">Keeping the site alive</h3>
            <CheckList items={monthlyHosting} tone="amber" />
          </div>
        </div>
        <p class="dim">Without this, sites break quietly. Plugins go out of date, forms stop sending, and you find out three months later when you wonder why nobody&rsquo;s calling.</p>
      </div>
      <div class="shot">
        <Image src={jobApp} alt="The ProSites job management dashboard, showing job counts, today's schedule and quick actions"
               widths={[480, 720, 900]} sizes="(max-width: 900px) 100vw, 45vw" />
      </div>
    </div>
  </section>

  <section class="sec wrap stack" style="gap:32px">
    <div class="stack center" style="gap:10px">
      <h2>Recent work</h2>
      <p class="lede">Trades first, then the demo sites you can click through.</p>
    </div>
    <div class="grid g-3">
      {work.map((w) => (
        <div class="stack" style="gap:12px">
          <Ph label={`${w.t.toUpperCase()} — SCREENSHOT`} ratio="4 / 3" />
          <h3>{w.t}</h3>
        </div>
      ))}
    </div>
    <Button href="/our-work/" variant="ghost" class="self-center">See All Our Work</Button>
  </section>

  <section class="band">
    <div class="sec wrap stack" style="gap:34px">
      <h2 class="center-text">What clients say</h2>
      <div class="grid g-3">
        {testimonials.map((t) => (
          <figure class="quote">
            <div class="stars" role="img" aria-label="Rated five out of five">
              {[0,1,2,3,4].map(() => (
                <svg width="18" height="18" viewBox="0 0 24 24" fill="var(--c-amber)" aria-hidden="true"><path d="M12 2.4l2.9 6.1 6.6.9-4.8 4.7 1.2 6.6L12 17.6l-5.9 3.1 1.2-6.6-4.8-4.7 6.6-.9z"/></svg>
              ))}
            </div>
            <blockquote>{t.quote}</blockquote>
            <figcaption class="quote__by">
              <Image src={avatar} alt="" width={42} height={42} class="quote__av" />
              <span><strong>{t.name}</strong><br />{t.detail}</span>
            </figcaption>
          </figure>
        ))}
      </div>
      <p class="warn">Placeholders — real testimonials only. Remove the duplicated one currently on the live site.</p>
    </div>
  </section>

  <section class="sec wrap faq-wrap">
    <h2>Questions</h2>
    <Faq items={faqs} />
  </section>

  <section class="cta">
    <div class="wrap cta__in">
      <div class="stack" style="gap:8px">
        <h2 class="cta__h">Ready to stop losing jobs to your competitors?</h2>
        <p class="lede">Tell us about your business in one short form. We reply within a working day with your start date — no meeting, no proposal document.</p>
      </div>
      <div class="hero__btns">
        <Button href="/start/">Start Your Brief</Button>
        <Button href="/pricing/" variant="ghost">View Pricing</Button>
      </div>
    </div>
  </section>

  <CallBar />
</Base>

<style>
  .hero { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); background: var(--c-petrol); }
  .hero__copy { display: grid; align-items: center; padding: 68px var(--gut); }
  .hero__inner { max-width: 560px; margin-left: auto; width: 100%; }
  .hero h1 { color: #fff; text-wrap: balance; }
  .hero p { color: var(--c-on-dark); }
  .hero__note { font-size: var(--t-small); font-weight: 500; color: #8fa9a6 !important; }
  .hero__btns { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; }
  .hero__img { width: 100%; height: 100%; min-height: 520px; object-fit: cover; }
  @media (max-width: 900px) {
    .hero { grid-template-columns: minmax(0, 1fr); }
    .hero__copy { padding: 40px var(--gut); }
    .hero__inner { max-width: none; margin: 0; }
    .hero__img { min-height: 0; aspect-ratio: 16 / 10; }
  }
  @media (min-width: 901px) { .hero__inner { padding-right: 40px; } }

  .trust { background: #e2edeb; border-bottom: 1px solid #cfdfdc; padding-block: 56px; }
  .trust__c { padding: 22px 20px; display: flex; flex-direction: column; gap: 12px; }
  .trust__t { font-size: 1.125rem; font-weight: 800; letter-spacing: -0.01em; line-height: 1.3; }

  .split { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 64px; align-items: center; }
  .split__img { border-radius: var(--r-lg); width: 100%; aspect-ratio: 16 / 11; object-fit: cover; }
  @media (max-width: 900px) { .split { grid-template-columns: minmax(0, 1fr); gap: 28px; } }

  .band { background: var(--c-surface); border-block: 1px solid var(--c-border); }
  .center { align-items: center; text-align: center; }
  .center-text { text-align: center; }
  .center-btns { justify-content: center; }
  .measure { max-width: 76ch; }
  :global(.self-start) { align-self: flex-start; }
  .self-center { align-self: center; }

  .rule { display: flex; align-items: center; gap: 14px; }
  .rule i { flex-grow: 1; height: 1px; background: #dde2dc; }

  .feat { padding: 28px 26px; display: flex; flex-direction: column; gap: 14px; }
  .feat h3 { font-size: 1.25rem; font-weight: 800; }
  .feat__d { font-size: 1rem; line-height: 1.55; color: var(--c-muted); }

  .squiggle { max-width: 100%; }
  .demo-shot { max-width: 900px; }

  .chips { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; list-style: none; margin: 0; padding: 0; max-width: 1000px; }
  .chip { background: var(--c-surface); border: 1px solid var(--c-border); border-radius: var(--r-pill); font-size: 1rem; font-weight: 600; padding: 10px 18px; color: #2c3a38; }

  .dim { color: var(--c-on-dark-2) !important; }
  .shot { background: #fff; border-radius: var(--r-lg); padding: 8px; box-shadow: 0 14px 40px rgba(0,0,0,0.28); align-self: center; }
  .shot :global(img) { border-radius: 10px; width: 100%; height: auto; }

  .quote { margin: 0; background: var(--c-bg); border: 1px solid var(--c-border); border-radius: 16px; padding: 26px 24px; display: flex; flex-direction: column; gap: 14px; }
  .stars { display: flex; gap: 3px; }
  .quote blockquote { margin: 0; font-size: 1.0625rem; line-height: 1.6; color: #2c3a38; }
  .quote__by { display: flex; align-items: center; gap: 12px; font-size: 0.9375rem; color: var(--c-muted-2); }
  .quote__av { border-radius: var(--r-pill); object-fit: cover; }
  .warn { font-size: var(--t-small); font-weight: 600; color: var(--c-flare); text-align: center; }

  .faq-wrap { display: grid; grid-template-columns: 340px minmax(0, 1fr); gap: 60px; align-items: start; }
  @media (max-width: 900px) { .faq-wrap { grid-template-columns: minmax(0, 1fr); gap: 24px; } }

  .cta { background: var(--c-surface-alt); border-top: 1px solid var(--c-border); }
  .cta__in { padding-block: 44px; display: flex; align-items: center; justify-content: space-between; gap: 40px; flex-wrap: wrap; }
  .cta__h { font-size: clamp(1.5rem, 1.2rem + 1.2vw, 1.75rem); }
</style>
