---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import Button from '../components/Button.astro';
import CtaBand from '../components/CtaBand.astro';
import CallBar from '../components/CallBar.astro';
import { meta } from '../data/content';
import jobApp from '../assets/placeholder/job-app.jpg';
import demoMobile from '../assets/demo-ridgeway-mobile.webp';
import jobAppJobs from '../assets/job-app-jobs.webp';
import jobAppMobile from '../assets/job-app-mobile.webp';
import pagespeed from '../assets/pagespeed-ridgeway.webp';
import demoLong from '../assets/demo-ridgeway-long.webp';
import Icon from '../components/Icon.astro';

const why = [
  { icon: 'mobile', t: 'The hero does one job', d: 'Your business name, what you fix, where you work, and a phone number. A customer with a leaking pipe doesn&rsquo;t want to read about your company values — they want to know you cover their suburb and that you&rsquo;ll answer.' },
  { icon: 'phone', t: 'The call button never disappears', d: 'On mobile, it&rsquo;s fixed to the bottom of the screen the entire time. The most common reason a service website fails is that finding the number takes too long.' },
  { icon: 'list', t: 'Services are listed in plain language', d: '&ldquo;Blocked drains,&rdquo; not &ldquo;comprehensive drainage solutions.&rdquo; Customers search using the words they&rsquo;d use to describe the problem.' },
  { icon: 'pinDot', t: 'Service areas are spelled out', d: 'Listing your suburbs does two things: it reassures the customer you cover them, and it helps you appear in local searches.' },
  { icon: 'shield', t: 'Trust sits above the fold on mobile', d: 'Reviews, years in business, callout guarantees, payment methods. A stranger is about to let you into their home.' },
  { icon: 'doc', t: 'The quote form is short', d: 'Name, number, suburb, what&rsquo;s wrong. Every additional field loses enquiries.' },
];
---

<Base title={meta.demo.title} description={meta.demo.description}>

  <section class="phero on-petrol">
    <div class="wrap stack" style="gap:20px; max-width:860px">
      <h1>See the Home Service Website in Action</h1>
      <p>This is the same structure your website will be built on. Click through it, open it on your phone, and see exactly what your customers would experience.</p>
      <div class="btns">
        <Button href="/demo/appliance-repair/">Open the Live Demo</Button>
        <Button href="#app" variant="onDark">Preview the Job App</Button>
      </div>
    </div>
  </section>

  <section class="sec wrap stack" style="gap:34px">
    <div class="stack" style="gap:12px">
      <h2>Proven website features that bring you more leads</h2>
      <p class="lede measure">Every part of this page earns its place. Here is what each one is doing, and why.</p>
    </div>
    <div class="wsplit">
      <div class="wsplit__media">
        <Image src={demoLong} alt="The demo site on a desktop screen, from the hero down through the services and service areas"
               widths={[420, 640, 900]} sizes="(max-width: 900px) 100vw, 42vw" class="wsplit__img" />
      </div>
      <ul class="wlist">
        {why.map((w) => (
          <li class="wlist__i">
            <Icon name={w.icon} size={26} class="wlist__ic" />
            <div class="stack" style="gap:4px">
              <h3 class="wlist__t" set:html={w.t} />
              <p class="lede" set:html={w.d} />
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band">
    <div class="sec wrap split">
      <div class="phone">
        <Image src={demoMobile} alt="A demo client site on a phone, with the call button fixed to the bottom of the screen"
               widths={[260, 520]} sizes="(max-width: 900px) 62vw, 280px" />
      </div>
      <div class="stack" style="gap:18px">
        <h2>On a phone</h2>
        <p class="lede">Most of your customers will find you on a phone, often standing next to the problem. The site is designed for that first and adapted for desktop second.</p>
      </div>
    </div>
  </section>

  <section class="sec wrap split">
    <div class="stack" style="gap:18px">
      <h2>Speed</h2>
      <p class="lede">A site that takes five seconds to load loses a third of its visitors before it appears. Ours are built lean.</p>
      <p class="lede">Google&rsquo;s PageSpeed Insights scores the demo site 100 for performance, 100 for best practices, 100 for SEO and 97 for accessibility.</p>
    </div>
    <div class="shot">
      <Image src={pagespeed} alt="Google PageSpeed Insights results for the demo site: 100 performance, 97 accessibility, 100 best practices, 100 SEO"
             widths={[560, 840, 1200]} sizes="(max-width: 900px) 100vw, 45vw" />
    </div>
  </section>

  <section class="band" id="app">
    <div class="sec wrap split">
      <div class="stack" style="gap:18px">
        <h2>The job app that comes with it</h2>
        <p class="lede">Every enquiry the site takes opens as a job here — with the customer&rsquo;s name, number and suburb already on it. Track it from enquiry to paid, assign it to whoever is closest, and keep the history for the next time they call.</p>
        <p class="lede">It is included in the monthly plan. There is nothing extra to buy and nothing to install.</p>
      </div>
      <div class="appshot">
        <Image src={jobAppJobs} alt="The job app jobs list on a laptop, showing each job with its number, status and customer"
               widths={[480, 720, 1100]} sizes="(max-width: 900px) 100vw, 45vw" class="appshot__d" />
        <Image src={jobAppMobile} alt="The same jobs list on a phone" widths={[170, 340]} sizes="150px" class="appshot__m" />
      </div>
    </div>
  </section>

  <section class="sec wrap stack" style="gap:16px; max-width:820px">
    <h2>Your version</h2>
    <p class="lede">Your site will use this structure with your logo, your colours, your services, your suburbs and your photos. We&rsquo;re not going to redesign it from scratch — that&rsquo;s exactly why it&rsquo;s affordable and why it goes live in two weeks.</p>
  </section>

  <CtaBand />
  <CallBar />
</Base>

<style>
  .phero { padding-block: clamp(2.5rem, 1.8rem + 3vw, 4rem); }
  .phero h1 { color: #fff; text-wrap: balance; }
  .btns { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; margin-top: 4px; }
  .band { background: var(--c-surface); border-block: 1px solid var(--c-border); }
  .wsplit { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: 56px; align-items: start; }
  .wsplit__media { position: sticky; top: 100px; max-height: 78vh; overflow: hidden; border-radius: var(--r-md);
    border: 1px solid var(--c-border); box-shadow: var(--sh-raised); }
  /* The page carries on below the crop, so fade the cut rather than slicing it. */
  .wsplit__media::after {
    content: ''; position: absolute; inset: auto 0 0 0; height: 90px; pointer-events: none;
    background: linear-gradient(to bottom, rgba(244, 245, 241, 0), var(--c-bg));
  }
  .wsplit__img { display: block; width: 100%; height: auto; }
  .wlist { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 24px; }
  .wlist__i { display: flex; gap: 16px; align-items: flex-start; }
  .wlist__ic { flex: 0 0 auto; margin-top: 2px; }
  .wlist__t { font-size: 1.0625rem; font-weight: 800; }
  @media (max-width: 900px) {
    .wsplit { grid-template-columns: minmax(0, 1fr); gap: 28px; }
    .wsplit__media { position: static; max-height: 60vh; }
  }
  .split { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 64px; align-items: center; }
  @media (max-width: 900px) { .split { grid-template-columns: minmax(0, 1fr); gap: 28px; } }
  .phone {
    width: min(280px, 62vw); padding: 8px; border-radius: 30px; justify-self: center;
    background: var(--c-carbon); box-shadow: var(--sh-raised);
  }
  .phone :global(img) { width: 100%; height: auto; display: block; border-radius: 23px; }

  .appshot { position: relative; }
  .appshot__d {
    display: block; width: 100%; height: auto; border-radius: var(--r-md);
    border: 1px solid var(--c-border); box-shadow: var(--sh-raised);
  }
  .appshot__m {
    position: absolute; right: -10px; bottom: -26px; width: 150px; height: auto;
    border-radius: 14px; border: 3px solid #fff; box-shadow: 0 16px 34px rgba(13, 27, 26, 0.22);
  }
  @media (max-width: 700px) { .appshot__m { width: 96px; right: -4px; bottom: -14px; border-width: 2px; } }

  .shot { background: #fff; border: 1px solid var(--c-border); border-radius: var(--r-lg); padding: 8px; box-shadow: var(--sh-raised); }
  .shot :global(img) { border-radius: 10px; width: 100%; height: auto; }
</style>
