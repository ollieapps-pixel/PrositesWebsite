---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import Button from '../components/Button.astro';
import Ph from '../components/Ph.astro';
import CtaBand from '../components/CtaBand.astro';
import CallBar from '../components/CallBar.astro';
import { meta } from '../data/content';
import jobApp from '../assets/placeholder/job-app.jpg';

const why = [
  { t: 'The hero does one job', d: 'Your business name, what you fix, where you work, and a phone number. A customer with a leaking pipe doesn&rsquo;t want to read about your company values — they want to know you cover their suburb and that you&rsquo;ll answer.' },
  { t: 'The call button never disappears', d: 'On mobile, it&rsquo;s fixed to the bottom of the screen the entire time. The most common reason a service website fails is that finding the number takes too long.' },
  { t: 'Services are listed in plain language', d: '&ldquo;Blocked drains,&rdquo; not &ldquo;comprehensive drainage solutions.&rdquo; Customers search using the words they&rsquo;d use to describe the problem.' },
  { t: 'Service areas are spelled out', d: 'Listing your suburbs does two things: it reassures the customer you cover them, and it helps you appear in local searches.' },
  { t: 'Trust sits above the fold on mobile', d: 'Reviews, years in business, callout guarantees, payment methods. A stranger is about to let you into their home.' },
  { t: 'The quote form is short', d: 'Name, number, suburb, what&rsquo;s wrong. Every additional field loses enquiries.' },
];
---

<Base title={meta.demo.title} description={meta.demo.description}>

  <section class="phero on-petrol">
    <div class="wrap stack" style="gap:20px; max-width:860px">
      <h1>See the Home Service Website in Action</h1>
      <p>This is the same structure your website will be built on. Click through it, open it on your phone, and see exactly what your customers would experience.</p>
      <div class="btns">
        <Button href="#">Open the Live Demo</Button>
        <Button href="#app" variant="onDark">Preview the Job App</Button>
      </div>
    </div>
  </section>

  <section class="sec wrap stack" style="gap:34px">
    <h2>Why it&rsquo;s built this way</h2>
    <div class="grid g-2">
      {why.map((w) => (
        <div class="card why">
          <h3 set:html={w.t} />
          <p class="lede" set:html={w.d} />
        </div>
      ))}
    </div>
  </section>

  <section class="band">
    <div class="sec wrap split">
      <Ph label="MOBILE MOCKUPS — DEMO SITE ON A PHONE" ratio="4 / 3" />
      <div class="stack" style="gap:18px">
        <h2>On a phone</h2>
        <p class="lede">Most of your customers will find you on a phone, often standing next to the problem. The site is designed for that first and adapted for desktop second.</p>
      </div>
    </div>
  </section>

  <section class="sec wrap split">
    <div class="stack" style="gap:18px">
      <h2>Speed</h2>
      <p class="lede">A site that takes five seconds to load loses a third of its visitors before it appears. Ours are built lean.</p>
    </div>
    <Ph label="PAGESPEED RESULT FOR THE DEMO SITE" ratio="16 / 9" />
  </section>

  <section class="band" id="app">
    <div class="sec wrap split">
      <div class="stack" style="gap:18px">
        <h2>The job app that comes with it</h2>
        <p class="lede">Every enquiry the site takes opens as a job here — with the customer&rsquo;s name, number and suburb already on it. Track it from enquiry to paid, assign it to whoever is closest, and keep the history for the next time they call.</p>
        <p class="lede">It is included in the monthly plan. There is nothing extra to buy and nothing to install.</p>
      </div>
      <div class="shot">
        <Image src={jobApp} alt="The ProSites job management dashboard, showing job counts, today's schedule and quick actions"
               widths={[480, 720, 900]} sizes="(max-width: 900px) 100vw, 45vw" />
      </div>
    </div>
  </section>

  <section class="sec wrap stack" style="gap:16px; max-width:820px">
    <h2>Your version</h2>
    <p class="lede">Your site will use this structure with your logo, your colours, your services, your suburbs and your photos. We&rsquo;re not going to redesign it from scratch — that&rsquo;s exactly why it&rsquo;s affordable and why it goes live in two weeks.</p>
  </section>

  <CtaBand />
  <CallBar />
</Base>

<style>
  .phero { padding-block: clamp(2.5rem, 1.8rem + 3vw, 4rem); }
  .phero h1 { color: #fff; text-wrap: balance; }
  .btns { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; margin-top: 4px; }
  .band { background: var(--c-surface); border-block: 1px solid var(--c-border); }
  .why { padding: 26px 24px; display: flex; flex-direction: column; gap: 10px; }
  .why h3 { font-size: 1.1875rem; font-weight: 800; }
  .split { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 64px; align-items: center; }
  @media (max-width: 900px) { .split { grid-template-columns: minmax(0, 1fr); gap: 28px; } }
  .shot { background: #fff; border: 1px solid var(--c-border); border-radius: var(--r-lg); padding: 8px; box-shadow: var(--sh-raised); }
  .shot :global(img) { border-radius: 10px; width: 100%; height: auto; }
</style>
