---
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import { contact } from '../../data/site';
---
<Base title="Thanks — we've got it | ProSites" description="Your enquiry has been received. We reply within one working day.">
  <section class="ty wrap">
    <div class="stack" style="gap:20px; max-width:640px">
      <h1>Got it. Thanks.</h1>
      <p class="lede">We&rsquo;ve received your details and we&rsquo;ll come back to you within one working day — usually a lot sooner — with your start date and an invoice for the 50% deposit.</p>
      <p class="lede">If it&rsquo;s urgent, WhatsApp is faster.</p>
      <div style="display:flex;gap:14px;flex-wrap:wrap">
        <Button href={contact.whatsappHref} variant="whatsapp">WhatsApp {contact.whatsapp}</Button>
        <Button href="/" variant="ghost">Back to the homepage</Button>
      </div>
    </div>
  </section>
</Base>
<style>
  .ty { padding-block: clamp(3rem, 2rem + 5vw, 6rem); }
</style>
