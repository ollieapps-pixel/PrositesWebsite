---
import DemoLayout from '../../../layouts/DemoLayout.astro';
import PageHero from '../../../components/demo/PageHero.astro';
import QuoteSection from '../../../components/demo/QuoteSection.astro';
import DemoFaq from '../../../components/demo/DemoFaq.astro';
import Icon from '../../../components/Icon.astro';
import { demoPaths } from '../../../data/demos';
import type { DemoSite } from '../../../data/demos/types';
import { faqsFor } from '../../../data/demos/types';
import { businessSchema, faqSchema, breadcrumbSchema } from '../../../data/demos/schema';

export function getStaticPaths() { return demoPaths(); }
const { site } = Astro.props as { site: DemoSite };
const base = `/demo/${site.slug}`;
const crumbs = [{ name: 'Home', href: `${base}/` }, { name: 'Services', href: `${base}/services/` }];
const faqs = faqsFor(site, 'services');
---
<DemoLayout
  site={site}
  current="services"
  title={`${site.servicesPage.h1} in ${site.region} | ${site.name}`}
  description={`${site.services.map((s) => s.title).slice(0, 3).join(', ')} and more across ${site.region}. See prices and book online.`}
  schema={[businessSchema(site, Astro.site, true), faqSchema(faqs), breadcrumbSchema(crumbs, Astro.site)]}
>
  <PageHero site={site} crumbs={crumbs} h1={site.servicesPage.h1} sub={site.servicesPage.sub} quoteHref="#quote" />

  <nav class="jump d-wrap" aria-label="Jump to a service">
    <ul>{site.services.map((s) => <li><a href={`#${s.id}`}>{s.title}</a></li>)}</ul>
  </nav>

  <div class="d-wrap svcs">
    {site.services.map((s) => (
      <section class="svc" id={s.id}>
        <div class="svc__head">
          <span class="svc__ico"><Icon name={s.icon} size={30} stroke="var(--d-navy)" /></span>
          <div class="svc__title">
            <h2>{s.title}</h2>
            <p class="svc__short">{s.short}</p>
          </div>
          <p class="svc__from"><span>From</span><strong>{s.from}</strong></p>
        </div>
        <div class="svc__cols">
          <div>
            <h3>Sounds familiar?</h3>
            <ul class="sq">{s.symptoms.map((x) => <li>{x}</li>)}</ul>
          </div>
          <div>
            <h3>What we fix</h3>
            <ul class="sq">{s.fixes.map((x) => <li>{x}</li>)}</ul>
          </div>
        </div>
        <a class="d-btn d-btn--call svc__go" href="#quote">Book this repair</a>
      </section>
    ))}
  </div>

  <section class="d-band">
    <div class="d-sec d-wrap">
      <div class="d-head"><h2>{site.servicesPage.pricingHeading}</h2></div>
      <div class="pr">
        {site.servicesPage.pricing.map((p) => (
          <div class="pr__i">
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </div>
        ))}
      </div>
      <p class="notlisted"><strong>Not listed?</strong> {site.servicesPage.notListed}</p>
    </div>
  </section>

  <QuoteSection site={site} heading="Book a repair" lede={site.contact.sub} />

  <section class="d-sec d-wrap faq">
    <div class="d-head"><h2>Questions about repairs</h2></div>
    <DemoFaq items={faqs} />
  </section>
</DemoLayout>

<style>
  .jump { padding-block: 20px; }
  .jump ul { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; margin: 0; padding: 0; }
  .jump a { display: inline-flex; align-items: center; min-height: 44px; padding: 8px 14px; border-radius: 0; border: 1px solid var(--d-line); background: var(--d-surface); color: var(--d-ink-2); font-weight: 700; font-size: 0.95rem; text-decoration: none; }
  .jump a:hover { border-color: var(--d-navy); color: var(--d-navy); }

  .svcs { display: flex; flex-direction: column; gap: 20px; padding-bottom: var(--d-sec); }
  .svc { background: var(--d-surface); border: 1px solid var(--d-line); border-radius: var(--d-r-card); padding: 28px; display: flex; flex-direction: column; gap: 22px; scroll-margin-top: 110px; }
  .svc__head { display: grid; grid-template-columns: 56px minmax(0, 1fr) auto; gap: 18px; align-items: start; }
  .svc__ico { display: grid; place-items: center; width: 56px; height: 56px; border-radius: 0; background: var(--d-tint); }
  .svc__title { display: flex; flex-direction: column; gap: 6px; }
  .svc__title h2 { font-size: clamp(1.35rem, 1.2rem + 0.6vw, 1.7rem); }
  .svc__short { color: var(--d-muted); }
  .svc__from { display: flex; flex-direction: column; align-items: flex-end; line-height: 1.1; }
  .svc__from span { font-size: 0.85rem; color: var(--d-muted); }
  .svc__from strong { font-size: 1.6rem; font-weight: 800; }
  .svc__cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px; padding-top: 22px; border-top: 1px solid var(--d-line); }
  .svc__cols h3 { font-size: 1.05rem; margin-bottom: 10px; }
  .sq { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .sq li { position: relative; padding-left: 20px; color: var(--d-ink-2); }
  .sq li::before { content: ''; position: absolute; left: 0; top: 0.62em; width: 8px; height: 8px; background: var(--d-accent); }
  .svc__go { align-self: flex-start; }
  @media (max-width: 760px) {
    .svc { padding: 22px 18px; }
    .svc__head { grid-template-columns: 48px minmax(0, 1fr); }
    .svc__ico { width: 48px; height: 48px; }
    .svc__from { grid-column: 2; flex-direction: row; align-items: baseline; gap: 8px; }
    .svc__cols { grid-template-columns: minmax(0, 1fr); gap: 20px; }
  }

  .pr { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 28px; }
  .pr__i { display: flex; flex-direction: column; gap: 8px; padding-top: 18px; border-top: 3px solid var(--d-navy); }
  .pr__i p { color: var(--d-muted); }
  @media (max-width: 900px) { .pr { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .pr { grid-template-columns: minmax(0, 1fr); gap: 20px; } }
  .notlisted { margin-top: 32px; padding: 18px 20px; background: var(--d-tint); color: var(--d-ink-2); }

  .faq { max-width: 860px; }
</style>
