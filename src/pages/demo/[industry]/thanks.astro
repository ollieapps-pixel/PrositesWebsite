---
import DemoLayout from '../../../layouts/DemoLayout.astro';
import { demoPaths } from '../../../data/demos';
import type { DemoSite } from '../../../data/demos/types';

export function getStaticPaths() { return demoPaths(); }
const { site } = Astro.props as { site: DemoSite };
---
<DemoLayout site={site} title={`Request received | ${site.name}`} description="Your request has been received." noindex>
  <section class="d-sec d-wrap ty">
    <h1>Thanks. We have your request.</h1>
    <p class="d-lede">We will confirm a time and the callout fee within working hours, usually within the hour. For anything urgent, WhatsApp is faster.</p>
    <div class="ty__b">
      <a class="d-btn d-btn--wa" href={site.whatsappHref}>WhatsApp us</a>
      <a class="d-btn d-btn--navy" href={`/demo/${site.slug}/`}>Back to the homepage</a>
    </div>
    <p class="ty__demo">This is a demo, so nobody will actually call you. <a href="/start/">Want this website for your own business?</a></p>
  </section>
</DemoLayout>
<style>
  .ty { display: flex; flex-direction: column; gap: 18px; max-width: 720px; }
  .ty__b { display: flex; gap: 12px; flex-wrap: wrap; }
  .ty__demo { margin-top: 12px; font-size: 0.95rem; color: var(--d-muted); }
</style>
