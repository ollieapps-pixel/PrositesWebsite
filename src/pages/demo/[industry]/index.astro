---
import { Image } from 'astro:assets';
import DemoLayout from '../../../layouts/DemoLayout.astro';
import TrustRow from '../../../components/demo/TrustRow.astro';
import ServiceGrid from '../../../components/demo/ServiceGrid.astro';
import ReasonsGrid from '../../../components/demo/ReasonsGrid.astro';
import StepsList from '../../../components/demo/StepsList.astro';
import ReviewList from '../../../components/demo/ReviewList.astro';
import QuoteSection from '../../../components/demo/QuoteSection.astro';
import DemoFaq from '../../../components/demo/DemoFaq.astro';
import Stars from '../../../components/demo/Stars.astro';
import Icon from '../../../components/Icon.astro';
import { demoPaths } from '../../../data/demos';
import type { DemoSite } from '../../../data/demos/types';
import { areaSlug, faqsFor } from '../../../data/demos/types';
import { businessSchema, faqSchema } from '../../../data/demos/schema';

export function getStaticPaths() { return demoPaths(); }
const { site } = Astro.props as { site: DemoSite };
const base = `/demo/${site.slug}`;
const faqs = faqsFor(site, 'home');
---
<DemoLayout
  site={site}
  current="home"
  title={`${site.home.h1} | ${site.name}`}
  description={`${site.home.sub} Rated ${site.rating} on Google.`}
  schema={[businessSchema(site, Astro.site, true), faqSchema(faqs)]}
>
  <section class="hero">
    <div class="d-wrap hero__in">
      <div class="hero__copy">
        <h1>{site.home.h1}</h1>
        <p class="hero__sub">{site.home.sub}</p>
        <div class="hero__btns">
          <a class="d-btn d-btn--call" href={site.phoneHref}><Icon name="phone" size={20} stroke="currentColor" />Call {site.phone}</a>
          <a class="d-btn d-btn--line" href="#quote">Get a quote</a>
        </div>
        <TrustRow site={site} dark />
      </div>
      <div class="hero__media">
        <Image src={site.images.hero} alt={site.images.heroAlt} widths={[560, 800, 1100]}
               sizes="(max-width: 900px) 100vw, 46vw" loading="eager" fetchpriority="high" />
      </div>
    </div>
  </section>

  {site.brands && (
    <section class="brands" aria-label={site.brands.label}>
      <div class="d-wrap brands__in">
        <p class="brands__l">{site.brands.label}</p>
        <ul>{site.brands.items.map((b) => <li>{b}</li>)}</ul>
      </div>
    </section>
  )}

  <section class="d-sec d-wrap" id="services">
    <div class="d-head">
      <h2>{site.home.servicesHeading}</h2>
      <p class="d-lede">{site.home.servicesLede}</p>
    </div>
    <ServiceGrid site={site} quoteHref="#quote" />
    <p class="more"><a href={`${base}/services/`}>See every repair, with prices</a></p>
  </section>

  <section class="d-band">
    <div class="d-sec d-wrap">
      <div class="d-head">
        <h2>{site.home.reasonsHeading}</h2>
        <p class="d-lede">{site.home.reasonsLede}</p>
      </div>
      <ReasonsGrid items={site.reasons} />
    </div>
  </section>

  <section class="d-sec d-wrap">
    <div class="d-head"><h2>How it works</h2></div>
    <StepsList site={site} />
  </section>

  <section class="d-band" id="reviews">
    <div class="d-sec d-wrap rv">
      <div class="rv__sum">
        <h2>What customers say</h2>
        <p class="rv__score">{site.rating}</p>
        <Stars size={24} label={`Rated ${site.rating} out of 5`} />
        <p class="d-lede">From {site.reviewCount} Google reviews</p>
        <a class="rv__more" href={`${base}/about/#reviews`}>Read more reviews</a>
      </div>
      <ReviewList site={site} limit={3} />
    </div>
  </section>

  <section class="d-sec d-wrap" id="areas">
    <div class="d-head">
      <h2>Areas we cover</h2>
      <p class="d-lede">We work across {site.region}. If your suburb is not listed, ask us anyway.</p>
    </div>
    <ul class="chips">
      {site.areas.map((a) => site.areaPages[areaSlug(a)]
        ? <li><a class="chip chip--link" href={`${base}/areas/${areaSlug(a)}/`}>{a}</a></li>
        : <li><span class="chip">{a}</span></li>)}
    </ul>
    <p class="more"><a href={`${base}/areas/`}>See all areas we cover</a></p>
  </section>

  <QuoteSection site={site} heading="Tell us what is wrong. We will sort out the rest." lede={site.contact.sub}>
    <Image src={site.images.contact} alt={site.images.contactAlt} widths={[480, 700]} sizes="(max-width: 900px) 100vw, 40vw" class="quote-img" />
  </QuoteSection>

  <section class="d-sec d-wrap faq" id="faq">
    <div class="d-head"><h2>Questions</h2></div>
    <DemoFaq items={faqs} />
  </section>
</DemoLayout>

<style>
  .hero { background: var(--d-navy-deep); color: #fff; overflow: hidden; }
  .hero__in { display: grid; grid-template-columns: 1.05fr 1fr; gap: 48px; align-items: center; padding-block: 56px; }
  .hero__copy { display: flex; flex-direction: column; gap: 22px; }
  .hero h1 { color: #fff; text-wrap: balance; }
  .hero__sub { font-size: 1.2rem; color: var(--d-on-navy); max-width: 44ch; }
  .hero__btns { display: flex; gap: 12px; flex-wrap: wrap; }
  .hero__copy :global(.trust) { margin-top: 10px; padding-top: 22px; border-top: 1px solid rgba(255,255,255,0.14); }
  .hero__media :global(img) { width: 100%; aspect-ratio: 5 / 4; object-fit: cover; border-radius: var(--d-r-card); }
  @media (max-width: 900px) {
    .hero__in { grid-template-columns: minmax(0, 1fr); gap: 28px; padding-block: 24px 32px; }
    .hero__media :global(img) { aspect-ratio: 16 / 10; }
  }
  /* Phones: the fixed call bar covers the bottom ~76px, so the whole trust row
     has to land above it on first load. */
  @media (max-width: 560px) {
    .hero__copy { gap: 16px; }
    .hero__sub { font-size: 1.05rem; line-height: 1.5; }
    .hero__btns { gap: 10px; }
    .hero__copy :global(.trust) { margin-top: 2px; padding-top: 16px; }
  }

  .brands { background: var(--d-surface); border-bottom: 1px solid var(--d-line); }
  .brands__in { display: flex; align-items: center; gap: 12px 32px; flex-wrap: wrap; padding-block: 18px; }
  .brands__l { font-size: 0.9rem; font-weight: 700; color: var(--d-muted); }
  .brands ul { display: flex; flex-wrap: wrap; gap: 8px 28px; list-style: none; margin: 0; padding: 0; }
  .brands li { font-size: 1.05rem; font-weight: 800; color: #8a96a5; letter-spacing: 0.01em; }

  .more { margin-top: 24px; }
  .more a { display: inline-flex; align-items: center; min-height: 44px; font-weight: 800; }

  .rv { display: grid; grid-template-columns: 280px minmax(0, 1fr); gap: 48px; align-items: start; }
  .rv__sum { display: flex; flex-direction: column; gap: 8px; }
  .rv__score { font-size: 4rem; font-weight: 800; line-height: 1; margin-top: 12px; letter-spacing: -0.03em; }
  .rv__more { display: inline-flex; align-items: center; min-height: 44px; font-weight: 800; }
  @media (max-width: 1000px) { .rv { grid-template-columns: minmax(0, 1fr); gap: 24px; } }

  .chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .chip { display: inline-flex; align-items: center; min-height: 44px; padding: 8px 18px; border-radius: 0; background: var(--d-surface); border: 1px solid var(--d-line); font-weight: 700; color: var(--d-ink-2); text-decoration: none; }
  .chip--link { border-color: var(--d-navy); color: var(--d-navy); }
  .chip--link:hover { background: var(--d-navy); color: #fff; }

  :global(.quote-img) { border-radius: var(--d-r-card); aspect-ratio: 16 / 11; object-fit: cover; margin-top: 8px; }
  @media (max-width: 900px) { :global(.quote-img) { display: none; } }

  .faq { max-width: 860px; }
</style>
