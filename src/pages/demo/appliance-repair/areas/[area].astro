---
import DemoLayout from '../../../../layouts/DemoLayout.astro';
import TrustRow from '../../../../components/demo/TrustRow.astro';
import ServiceGrid from '../../../../components/demo/ServiceGrid.astro';
import QuoteForm from '../../../../components/demo/QuoteForm.astro';
import DemoFaq from '../../../../components/demo/DemoFaq.astro';
import Stars from '../../../../components/demo/Stars.astro';
import Icon from '../../../../components/Icon.astro';
import { biz, areaPages, reviews, faqs } from '../../../../data/demo-appliance';

export function getStaticPaths() {
  return Object.keys(areaPages).map((area) => ({ params: { area } }));
}

const { area } = Astro.params;
const a = areaPages[area as string];
const local = reviews.filter((r) => r.area === a.name);
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'HomeAndConstructionBusiness',
    name: biz.name,
    url: new URL(`${biz.base}/`, Astro.site).href,
    telephone: '+27210000000',
    areaServed: { '@type': 'Place', name: `${a.name}, ${biz.city}` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: biz.name, item: new URL(`${biz.base}/`, Astro.site).href },
      { '@type': 'ListItem', position: 2, name: `Appliance repairs in ${a.name}`, item: pageUrl },
    ],
  },
];
---
<DemoLayout
  title={`Appliance Repairs in ${a.name} | ${biz.name}`}
  description={`Fridge, washing machine, oven and dishwasher repairs in ${a.name}, including ${a.neighbourhoods.slice(0, 3).join(', ')}. ${biz.callout} callout, ${biz.guaranteeDays}-day guarantee.`}
  schema={schema}
>
  <nav class="crumbs d-wrap" aria-label="Breadcrumb">
    <a href={`${biz.base}/`}>Home</a><span aria-hidden="true">/</span><span aria-current="page">{a.name}</span>
  </nav>

  <section class="ahero">
    <div class="d-wrap ahero__in">
      <h1>Appliance Repairs in {a.name}</h1>
      <p class="ahero__sub">{a.name} is one of our core areas, so there is usually a technician nearby. We come to your home in {a.neighbourhoods.slice(0, -1).join(', ')} and {a.neighbourhoods[a.neighbourhoods.length - 1]}.</p>
      <div class="ahero__btns">
        <a class="d-btn d-btn--call" href={biz.phoneHref}><Icon name="phone" size={20} stroke="currentColor" />Call {biz.phone}</a>
        <a class="d-btn d-btn--line" href="#quote">Get a quote</a>
      </div>
      <TrustRow dark />
    </div>
  </section>

  <section class="d-sec d-wrap">
    <div class="d-head">
      <h2>Repairs we do in {a.name}</h2>
      <p class="d-lede">Same services, same prices as everywhere else we work. No extra charge for {a.name}.</p>
    </div>
    <ServiceGrid quoteHref="#quote" />
  </section>

  {local.length > 0 && (
    <section class="d-band">
      <div class="d-sec d-wrap lr">
        <Stars size={22} />
        {local.map((r) => (
          <figure class="lr__q">
            <blockquote>&ldquo;{r.text}&rdquo;</blockquote>
            <figcaption><strong>{r.name}</strong>, {r.area}</figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}

  <section class="quote" id="quote">
    <div class="d-sec d-wrap quote__in">
      <div class="quote__copy">
        <h2>Book a repair in {a.name}</h2>
        <p class="quote__lede">Send the form and we will confirm a time and the {biz.callout} callout. Prefer to talk? Call or WhatsApp.</p>
        <div class="quote__alt">
          <a class="d-btn d-btn--call" href={biz.phoneHref}>Call {biz.phone}</a>
          <a class="d-btn d-btn--wa" href={biz.whatsappHref}>WhatsApp us</a>
        </div>
        <div class="nearby">
          <h3>Also near {a.name}</h3>
          <p>{a.nearby.join(', ')}</p>
        </div>
      </div>
      <QuoteForm suburb={a.name} />
    </div>
  </section>

  <section class="d-sec d-wrap faq">
    <div class="d-head"><h2>Questions</h2></div>
    <DemoFaq items={faqs.slice(0, 4)} />
  </section>
</DemoLayout>

<style>
  .crumbs { display: flex; gap: 8px; align-items: center; padding-block: 12px; font-size: 0.9rem; color: var(--d-muted); }
  .crumbs a { display: inline-flex; min-height: 44px; align-items: center; }
  .ahero { background: var(--d-navy-deep); color: #fff; }
  .ahero__in { display: flex; flex-direction: column; gap: 22px; padding-block: 48px; max-width: 900px; }
  .ahero h1 { color: #fff; }
  .ahero__sub { font-size: 1.15rem; color: var(--d-on-navy); max-width: 60ch; }
  .ahero__btns { display: flex; gap: 12px; flex-wrap: wrap; }
  .ahero :global(.trust) { padding-top: 22px; border-top: 1px solid rgba(255,255,255,0.14); }
  @media (max-width: 560px) {
    .ahero__in { gap: 16px; padding-block: 24px 32px; }
    .ahero__sub { font-size: 1.05rem; line-height: 1.5; }
    .ahero :global(.trust) { padding-top: 16px; }
  }

  .lr { display: flex; flex-direction: column; align-items: center; gap: 14px; text-align: center; }
  .lr__q { margin: 0; max-width: 60ch; }
  .lr__q blockquote { margin: 0 0 8px; font-size: 1.35rem; font-weight: 700; line-height: 1.4; }
  .lr__q figcaption { color: var(--d-muted); }

  .quote { background: #e9eff6; border-block: 1px solid var(--d-line); }
  .quote__in { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .quote__copy { display: flex; flex-direction: column; gap: 18px; }
  .quote__lede { color: var(--d-ink-2); font-size: 1.1rem; }
  .quote__alt { display: flex; gap: 12px; flex-wrap: wrap; }
  .nearby { margin-top: 10px; padding-top: 18px; border-top: 1px solid var(--d-line); display: flex; flex-direction: column; gap: 4px; }
  .nearby p { color: var(--d-muted); }
  @media (max-width: 900px) { .quote__in { grid-template-columns: minmax(0, 1fr); gap: 28px; } }
  .faq { max-width: 860px; }
</style>
