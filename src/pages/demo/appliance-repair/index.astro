---
import { Image } from 'astro:assets';
import DemoLayout from '../../../layouts/DemoLayout.astro';
import TrustRow from '../../../components/demo/TrustRow.astro';
import ServiceGrid from '../../../components/demo/ServiceGrid.astro';
import QuoteForm from '../../../components/demo/QuoteForm.astro';
import DemoFaq from '../../../components/demo/DemoFaq.astro';
import Stars from '../../../components/demo/Stars.astro';
import Icon from '../../../components/Icon.astro';
import { biz, brands, reasons, steps, reviews, areas, areaPages, areaSlug, faqs } from '../../../data/demo-appliance';
import hero from '../../../assets/placeholder/hero.jpg';
import customer from '../../../assets/placeholder/customer-searching.jpg';

const url = new URL(`${biz.base}/`, Astro.site).href;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'HomeAndConstructionBusiness',
    name: biz.name,
    description: `Appliance repairs at your home across ${biz.region}.`,
    url,
    telephone: '+27210000000',
    priceRange: `From ${biz.callout} callout`,
    address: { '@type': 'PostalAddress', addressLocality: biz.city, addressRegion: 'Western Cape', addressCountry: 'ZA' },
    areaServed: areas.map((a) => ({ '@type': 'Place', name: `${a}, ${biz.city}` })),
    openingHoursSpecification: [
      { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '07:30', closes: '17:30' },
      { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '08:00', closes: '13:00' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<DemoLayout
  title={`Appliance Repairs in ${biz.region} | ${biz.name}`}
  description={`Fridge, washing machine, oven and dishwasher repairs at your home. ${biz.callout} callout credited to the repair, ${biz.guaranteeDays}-day guarantee, same-week slots.`}
  schema={schema}
>
  <section class="hero">
    <div class="d-wrap hero__in">
      <div class="hero__copy">
        <h1>Appliance Repairs in {biz.region}</h1>
        <p class="hero__sub">Fridges, washing machines, ovens and dishwashers repaired at your home. Same-week callouts, and you know the price before we start.</p>
        <div class="hero__btns">
          <a class="d-btn d-btn--call" href={biz.phoneHref}><Icon name="phone" size={20} stroke="currentColor" />Call {biz.phone}</a>
          <a class="d-btn d-btn--line" href="#quote">Get a quote</a>
        </div>
        <TrustRow dark />
      </div>
      <div class="hero__media">
        <Image src={hero} alt="Ridgeway technician on a call in a customer's kitchen" widths={[560, 800, 1100]}
               sizes="(max-width: 900px) 100vw, 46vw" loading="eager" fetchpriority="high" />
      </div>
    </div>
  </section>

  <section class="brands" aria-label="Brands we repair">
    <div class="d-wrap brands__in">
      <p class="brands__l">We repair all major brands</p>
      <ul>{brands.map((b) => <li>{b}</li>)}</ul>
    </div>
  </section>

  <section class="d-sec d-wrap" id="services">
    <div class="d-head">
      <h2>What we fix</h2>
      <p class="d-lede">Tell us what the appliance is doing. You do not need to know what is broken.</p>
    </div>
    <ServiceGrid quoteHref="#quote" />
  </section>

  <section class="d-band">
    <div class="d-sec d-wrap why">
      <div class="d-head">
        <h2>No surprises on the bill</h2>
        <p class="d-lede">The things people worry about before they let a repairman into the house, answered upfront.</p>
      </div>
      <div class="why__grid">
        {reasons.map((r) => (
          <div class="why__i">
            <Icon name={r.icon} size={30} stroke="var(--d-navy)" />
            <h3>{r.title}</h3>
            <p>{r.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="d-sec d-wrap">
    <div class="d-head"><h2>How it works</h2></div>
    <ol class="steps">
      {steps.map((s, i) => (
        <li class="steps__i">
          <span class="steps__n" aria-hidden="true">{i + 1}</span>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="d-band" id="reviews">
    <div class="d-sec d-wrap rv">
      <div class="rv__sum">
        <h2>What customers say</h2>
        <p class="rv__score">{biz.rating}</p>
        <Stars size={24} label={`Rated ${biz.rating} out of 5`} />
        <p class="d-lede">From {biz.reviewCount} Google reviews</p>
      </div>
      <div class="rv__list">
        {reviews.map((r) => (
          <figure class="rv__c">
            <Stars size={16} />
            <blockquote>&ldquo;{r.text}&rdquo;</blockquote>
            <figcaption><strong>{r.name}</strong>, {r.area}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="d-sec d-wrap" id="areas">
    <div class="d-head">
      <h2>Areas we cover</h2>
      <p class="d-lede">We work across {biz.region}. If your suburb is not listed, ask us anyway.</p>
    </div>
    <ul class="areas">
      {areas.map((a) => areaPages[areaSlug(a)]
        ? <li><a class="areas__c areas__c--link" href={`${biz.base}/areas/${areaSlug(a)}/`}>{a}</a></li>
        : <li><span class="areas__c">{a}</span></li>)}
    </ul>
  </section>

  <section class="quote" id="quote">
    <div class="d-sec d-wrap quote__in">
      <div class="quote__copy">
        <h2>Tell us what is wrong. We will sort out the rest.</h2>
        <p class="quote__lede">Send the form and we will confirm a time and the {biz.callout} callout. Prefer to talk? Call or WhatsApp.</p>
        <div class="quote__alt">
          <a class="d-btn d-btn--call" href={biz.phoneHref}>Call {biz.phone}</a>
          <a class="d-btn d-btn--wa" href={biz.whatsappHref}>WhatsApp us</a>
        </div>
        <Image src={customer} alt="Customer booking an appliance repair on her phone" widths={[480, 700]}
               sizes="(max-width: 900px) 100vw, 40vw" class="quote__img" />
      </div>
      <QuoteForm />
    </div>
  </section>

  <section class="d-sec d-wrap faq" id="faq">
    <div class="d-head"><h2>Questions</h2></div>
    <DemoFaq items={faqs} />
  </section>
</DemoLayout>

<style>
  .hero { background: var(--d-navy-deep); color: #fff; overflow: hidden; }
  .hero__in { display: grid; grid-template-columns: 1.05fr 1fr; gap: 48px; align-items: center; padding-block: 56px; }
  .hero__copy { display: flex; flex-direction: column; gap: 22px; }
  .hero h1 { color: #fff; text-wrap: balance; }
  .hero__sub { font-size: 1.2rem; color: var(--d-on-navy); max-width: 44ch; }
  .hero__btns { display: flex; gap: 12px; flex-wrap: wrap; }
  .hero__copy :global(.trust) { margin-top: 10px; padding-top: 22px; border-top: 1px solid rgba(255,255,255,0.14); }
  .hero__media :global(img) { width: 100%; aspect-ratio: 5 / 4; object-fit: cover; border-radius: var(--d-r-card); }
  @media (max-width: 900px) {
    .hero__in { grid-template-columns: minmax(0, 1fr); gap: 28px; padding-block: 24px 32px; }
    .hero__media :global(img) { aspect-ratio: 16 / 10; }
  }
  /* Phones: the fixed call bar covers the bottom ~76px, so the whole trust row
     has to land above it on first load. */
  @media (max-width: 560px) {
    .hero__copy { gap: 16px; }
    .hero__sub { font-size: 1.05rem; line-height: 1.5; }
    .hero__btns { gap: 10px; }
    .hero__copy :global(.trust) { margin-top: 2px; padding-top: 16px; }
  }

  .brands { background: var(--d-surface); border-bottom: 1px solid var(--d-line); }
  .brands__in { display: flex; align-items: center; gap: 12px 32px; flex-wrap: wrap; padding-block: 18px; }
  .brands__l { font-size: 0.9rem; font-weight: 700; color: var(--d-muted); }
  .brands ul { display: flex; flex-wrap: wrap; gap: 8px 28px; list-style: none; margin: 0; padding: 0; }
  .brands li { font-size: 1.05rem; font-weight: 800; color: #8a96a5; letter-spacing: 0.01em; }

  .why__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 28px; }
  .why__i { display: flex; flex-direction: column; gap: 10px; }
  .why__i p { color: var(--d-muted); font-size: 1rem; }
  @media (max-width: 900px) { .why__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .why__grid { grid-template-columns: minmax(0, 1fr); gap: 22px; } }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; counter-reset: s; }
  .steps__i { display: flex; flex-direction: column; gap: 10px; padding-top: 20px; border-top: 3px solid var(--d-navy); }
  .steps__n { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--d-accent); color: var(--d-ink); font-weight: 800; }
  .steps__i p { color: var(--d-muted); }
  @media (max-width: 760px) { .steps { grid-template-columns: minmax(0, 1fr); } }

  .rv { display: grid; grid-template-columns: 280px minmax(0, 1fr); gap: 48px; align-items: start; }
  .rv__sum { display: flex; flex-direction: column; gap: 8px; }
  .rv__score { font-size: 4rem; font-weight: 800; line-height: 1; margin-top: 12px; letter-spacing: -0.03em; }
  .rv__list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .rv__c { margin: 0; background: var(--d-bg); border: 1px solid var(--d-line); border-radius: var(--d-r-card); padding: 20px; display: flex; flex-direction: column; gap: 10px; }
  .rv__c blockquote { margin: 0; font-size: 1rem; line-height: 1.55; }
  .rv__c figcaption { font-size: 0.92rem; color: var(--d-muted); }
  @media (max-width: 1000px) { .rv { grid-template-columns: minmax(0, 1fr); gap: 24px; } }
  @media (max-width: 760px) { .rv__list { grid-template-columns: minmax(0, 1fr); } }

  .areas { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .areas__c { display: inline-flex; align-items: center; min-height: 44px; padding: 8px 18px; border-radius: 999px; background: var(--d-surface); border: 1px solid var(--d-line); font-weight: 700; color: var(--d-ink-2); text-decoration: none; }
  .areas__c--link { border-color: var(--d-navy); color: var(--d-navy); }
  .areas__c--link:hover { background: var(--d-navy); color: #fff; }

  .quote { background: #e9eff6; border-block: 1px solid var(--d-line); }
  .quote__in { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .quote__copy { display: flex; flex-direction: column; gap: 18px; }
  .quote__lede { color: var(--d-ink-2); font-size: 1.1rem; }
  .quote__alt { display: flex; gap: 12px; flex-wrap: wrap; }
  .quote__copy :global(.quote__img) { border-radius: var(--d-r-card); aspect-ratio: 16 / 11; object-fit: cover; margin-top: 8px; }
  @media (max-width: 900px) { .quote__in { grid-template-columns: minmax(0, 1fr); gap: 28px; } .quote__copy :global(.quote__img) { display: none; } }

  .faq { max-width: 860px; }
</style>
