---
import Base from '../layouts/Base.astro';
import Ph from '../components/Ph.astro';
import CtaBand from '../components/CtaBand.astro';
import CallBar from '../components/CallBar.astro';
import { meta } from '../data/content';

const demos = [
  'Appliance Repair — Cape Town',
  'Plumbing — Cape Town',
  'Electrical — Cape Town',
];
---

<Base title={meta.work.title} description={meta.work.description}>

  <section class="phero on-petrol">
    <div class="wrap stack" style="gap:18px; max-width:820px">
      <h1>Our Work</h1>
      <p>Websites we&rsquo;ve built for service businesses in Cape Town and beyond.</p>
    </div>
  </section>

  <section class="sec wrap stack" style="gap:26px">
    <h2>Client sites</h2>
    <div class="feature">
      <Ph label="FIXITT GLASS — SCREENSHOT" ratio="16 / 9" />
      <div class="stack" style="gap:10px">
        <h3>FixItt Glass</h3>
        <p class="lede">[One line on what this site does for them — ideally the enquiry or call result, once you have it.]</p>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="sec wrap stack" style="gap:26px">
      <div class="stack" style="gap:10px">
        <h2>Home Service Website Examples</h2>
        <p class="lede measure">These are demonstration sites built to show the home service website in different trades. Each one is a working site you can click through.</p>
      </div>
      <div class="grid g-3">
        {demos.map((d) => (
          <div class="stack" style="gap:12px">
            <Ph label={`${d.toUpperCase()} — DEMO`} ratio="4 / 3" />
            <h3>{d}</h3>
            <span class="tagd">Demo site</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec wrap stack" style="gap:26px">
    <div class="stack" style="gap:10px">
      <h2>Other projects</h2>
      <p class="lede measure">Over the last decade we&rsquo;ve built sites across a range of industries. Today we focus on home service businesses.</p>
    </div>
    <div class="grid g-4">
      {[1, 2, 3, 4].map((n) => <Ph label={`OTHER PROJECT ${n}`} ratio="4 / 3" />)}
    </div>
  </section>

  <CtaBand />
  <CallBar />
</Base>

<style>
  .phero { padding-block: clamp(2.5rem, 1.8rem + 3vw, 4rem); }
  .phero h1 { color: #fff; }
  .band { background: var(--c-surface); border-block: 1px solid var(--c-border); }
  .feature { display: grid; grid-template-columns: 1.4fr 1fr; gap: 40px; align-items: center; }
  @media (max-width: 900px) { .feature { grid-template-columns: minmax(0, 1fr); gap: 20px; } }
  .feature h3 { font-size: 1.5rem; font-weight: 800; }
  .measure { max-width: 76ch; }
  .tagd { font-size: 0.8rem; font-weight: 800; letter-spacing: 0.04em; color: var(--c-muted-2); }
</style>
