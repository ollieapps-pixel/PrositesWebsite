---
import '@fontsource-variable/manrope';
import '../styles/demo.css';
import type { DemoSite } from '../data/demos/types';
import { themeStyle } from '../data/demos/types';
import DemoStrip from '../components/demo/DemoStrip.astro';
import DemoHeader from '../components/demo/DemoHeader.astro';
import DemoFooter from '../components/demo/DemoFooter.astro';
import DemoCallBar from '../components/demo/DemoCallBar.astro';

export type DemoPage = 'home' | 'services' | 'areas' | 'about' | 'contact';

interface Props {
  site: DemoSite;
  title: string;
  description: string;
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  current?: DemoPage;
}
const { site, title, description, schema = [], noindex = false, current } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="en-ZA" style={themeStyle(site.theme)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_ZA" />
    <meta name="theme-color" content={site.theme.navyDeep} />
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="d-skip" href="#main">Skip to content</a>
    <DemoStrip site={site} />
    <DemoHeader site={site} current={current} />
    <main id="main"><slot /></main>
    <DemoFooter site={site} />
    <DemoCallBar site={site} />
  </body>
</html>
