---
import '@fontsource-variable/manrope';
import '../styles/demo.css';
import DemoStrip from '../components/demo/DemoStrip.astro';
import DemoHeader from '../components/demo/DemoHeader.astro';
import DemoFooter from '../components/demo/DemoFooter.astro';
import DemoCallBar from '../components/demo/DemoCallBar.astro';

interface Props {
  title: string;
  description: string;
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}
const { title, description, schema = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="en-ZA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_ZA" />
    <meta name="theme-color" content="#0b2545" />
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="d-skip" href="#main">Skip to content</a>
    <DemoStrip />
    <DemoHeader />
    <main id="main"><slot /></main>
    <DemoFooter />
    <DemoCallBar />
  </body>
</html>
